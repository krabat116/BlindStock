generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StockType {
  COUNT
  LENGTH
  AREA
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id               Int           @id @default(autoincrement())
  name             String

  stockType        StockType     @default(COUNT)

  // COUNT type
  quantity         Int?
  minimumStock     Int?
  unit             String?

  // LENGTH type
  defaultLengthMm  Int?
  totalLengthMm    Int?
  minimumLengthMm  Int?
  cutoffLengthMm   Int?  // 막대 하나당 사용 불가 끝부분 길이(mm), 기본값 800

  // AREA type (fabric/material)
  totalAreaMm2        BigInt?
  minimumAreaMm2      BigInt?
  rollWidthMm         Int?  // Fabric roll width (mm) — used in FFDH strip packing
  defaultRollLengthMm Int?  // Standard length of one roll (mm) — used to display roll count

  categoryId       Int
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions     Transaction[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([name, categoryId])
}

model Transaction {
  id             Int      @id @default(autoincrement())
  itemId         Int
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type           String

  // COUNT transaction
  quantity       Int?

  // LENGTH transaction
  lengthMm       Int?

  // AREA transaction
  areaMm2        BigInt?

  source         String?
  note           String?
  createdAt      DateTime @default(now())
}

// Customer page related

model Customer {
  id          String   @id @default(cuid())
  accountName String   @unique
  name        String?
  phone       String?
  email       String?
  companyName String?
  address     String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      CustomerOrder[]

  @@index([accountName])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([companyName])
}

model CustomerOrder {
  id           String      @id @default(cuid())
  customerId   String
  orderYear    Int
  orderMonth   Int
  orderSheetNo Int
  totalItems   Int         @default(0)
  fileName     String?
  fileHash     String?
  status       OrderStatus @default(PENDING)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  // One-to-one: the uploaded Excel sheet that created this order
  uploadedWorkOrderSheet UploadedWorkOrderSheet?

  @@index([customerId])
  @@index([orderYear, orderMonth])
  @@unique([orderYear, orderSheetNo])
}

model OrderItem {
  id              String   @id @default(cuid())
  customerOrderId String
  itemType        String
  itemName        String
  quantity        Int
  unit            String?
  createdAt       DateTime @default(now())

  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  @@index([customerOrderId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// Auth

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Work order relations
  uploadedWorkOrderSheets UploadedWorkOrderSheet[]
  workActivities          WorkActivity[]
}

enum UserRole {
  ADMIN
  STAFF
}

model ContinuationRowRule {
  id           Int      @id @default(autoincrement())
  keyword      String   @unique
  categoryName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Work Order models ──────────────────────────────────────────────────────

/// Represents one uploaded Excel order sheet
model UploadedWorkOrderSheet {
  id              String   @id @default(cuid())
  customerOrderId String   @unique   // 1-to-1 with CustomerOrder
  fileName        String
  fileHash        String   @unique   // SHA-256 for duplicate detection
  fileSize        Int
  uploadedById    Int
  uploadedAt      DateTime @default(now())

  customerOrder   CustomerOrder  @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  uploadedBy      User           @relation(fields: [uploadedById], references: [id])
  workOrderGroups WorkOrderGroup[]
}

/// One Account + Customer Name combination within an uploaded sheet
model WorkOrderGroup {
  id                       String   @id @default(cuid())
  uploadedWorkOrderSheetId String
  account                  String
  customerName             String
  createdAt                DateTime @default(now())

  uploadedSheet UploadedWorkOrderSheet @relation(fields: [uploadedWorkOrderSheetId], references: [id], onDelete: Cascade)
  rows          WorkOrderRow[]

  @@index([uploadedWorkOrderSheetId])
  @@index([account, customerName])
}

/// One Excel data row — either a blind work row or an accessory/note row
model WorkOrderRow {
  id               String   @id @default(cuid())
  workOrderGroupId String
  sourceRowNumber  Int      // 1-based Excel row number; rows are shown in this order
  isAccessoryRow   Boolean  @default(false)

  // Blind work row fields
  blindNumber       String?
  additionalRef     String?  // column next to BLIND NO (tube override etc.)
  room              String?
  widthMm           Int?
  dropMm            Int?
  materialRange     String?
  materialColour    String?
  tape              String?
  roll              String?
  finish            String?
  componentryColour String?
  chainOperation    String?  // raw operation value, e.g. "SWIVEL 1250"
  side              String?
  chain             String?  // normalised chain type, e.g. "METAL"
  quantity          Int?
  accessoriesNotes  String?  // used for accessory rows and ACCESSORIES & NOTES column

  createdAt DateTime @default(now())

  group      WorkOrderGroup @relation(fields: [workOrderGroupId], references: [id], onDelete: Cascade)
  activities WorkActivity[]

  @@index([workOrderGroupId])
}

enum WorkType {
  FABRIC_CUTTING
  TUBE_CUTTING
  ASSEMBLING
  PACKING
  INSPECTING
}

/// Staff member's work record for one row × work type combination
model WorkActivity {
  id             String   @id @default(cuid())
  workOrderRowId String
  workType       WorkType
  staffUserId    Int
  displayValue   String   // username for now; can be replaced with initials later
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrderRow WorkOrderRow @relation(fields: [workOrderRowId], references: [id], onDelete: Cascade)
  staffUser    User         @relation(fields: [staffUserId], references: [id])

  @@unique([workOrderRowId, workType])  // one activity per row per work type
  @@index([staffUserId])
}